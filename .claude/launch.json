{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wewin/api", "dev"],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wewin/web", "dev"],
      "port": 5173
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wewin/api", "dev"],
      "env": { "PORT": "4010" },
      "port": 4010
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wewin/web", "dev"],
      "env": { "WEB_PORT": "5180", "API_PROXY_TARGET": "http://localhost:4010" },
      "port": 5180
    }
  ]
}
