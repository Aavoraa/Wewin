# Copy to .env (never commit .env). Names only for secrets in production.
DATABASE_URL=postgresql://wewin:wewin@localhost:5432/wewin_erp
TEST_DATABASE_URL=postgresql://wewin:wewin@localhost:5432/wewin_erp_test
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:5173
PORT=4000
TZ=Asia/Kolkata
FY_START_MONTH=4
NODE_ENV=development
LOG_LEVEL=info
# Where attachments and generated exports are written (dev: local disk)
STORAGE_DIR=./storage
# Set to true only behind HTTPS (production) so the refresh cookie gets the Secure flag
COOKIE_SECURE=false
# Optional WhatsApp provider (later). Leave empty: deliveries are recorded as SKIPPED_NOT_CONFIGURED.
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Disable pg-boss workers (e.g. in tests)
JOBS_ENABLED=true
# Development seed only: initial password for the "owner" user (forced change is NOT applied in dev seed)
SEED_OWNER_PASSWORD=
