{
  "name": "@wewin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsup",
    "lint": "eslint src test",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@napi-rs/canvas": "0.1.80",
    "@prisma/client": "^6.16.0",
    "@wewin/db": "workspace:*",
    "@wewin/shared": "workspace:*",
    "argon2": "^0.44.0",
    "bwip-js": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfjs-dist": "5.4.296",
    "pg-boss": "^10.3.2",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "5.29.0",
    "tesseract.js": "6.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@wewin/config": "workspace:*",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "pdf-lib": "1.17.1",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
