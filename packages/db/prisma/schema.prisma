// Wewin ERP — database schema.
// Conventions: snake_case tables/columns, UUID ids, kg Decimal(12,3), money Decimal(14,2), rates Decimal(12,4).
// Only apps/api/src/core/ledger writes stock_movements. audit_log and stock_movements are append-only (DB triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum DocStatus {
  DRAFT
  POSTED
  CLOSED
  CANCELLED
}

enum Unit {
  KG
  PCS
  NOS
}

enum LocationKind {
  OWN
  VENDOR
  VIRTUAL
}

enum ItemType {
  YARN
  FABRIC
  PANEL
  GARMENT
  TRIM
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  username           String       @unique
  fullName           String       @map("full_name")
  email              String?
  phone              String?
  passwordHash       String       @map("password_hash")
  isActive           Boolean      @default(true) @map("is_active")
  failedLoginCount   Int          @default(0) @map("failed_login_count")
  lockedUntil        DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz(3)
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  version            Int          @default(1)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles              UserRole[]
  sessions           Session[]
  notifications      Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key         String           @id
  module      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh-token sessions. Token stored as SHA-256 hash; rotated on every refresh.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([username, createdAt])
  @@map("login_events")
}

// ───────────────────────────── Settings & numbering ─────────────────────────────

model CompanySettings {
  id           Int       @id @default(1)
  legalName    String    @map("legal_name")
  tradeName    String?   @map("trade_name")
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String
  state        String
  stateCode    String    @map("state_code")
  pincode      String
  gstin        String
  pan          String?
  phone        String?
  email        String?
  iec          String?
  lutNumber    String?   @map("lut_number")
  lutValidFrom DateTime? @map("lut_valid_from") @db.Date
  lutValidTo   DateTime? @map("lut_valid_to") @db.Date
  bankName     String?   @map("bank_name")
  bankAccount  String?   @map("bank_account")
  bankIfsc     String?   @map("bank_ifsc")
  logoFileKey  String?   @map("logo_file_key")
  isPlaceholder Boolean  @default(false) @map("is_placeholder")
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_settings")
}

/// Typed business settings (tolerances, GST windows, thresholds). Values validated by @wewin/shared.
model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model DocumentSeries {
  code     String  @id
  name     String
  prefix   String
  padding  Int     @default(4)
  isActive Boolean @default(true) @map("is_active")

  @@map("document_series")
}

model NumberSeries {
  id         String   @id @default(uuid()) @db.Uuid
  seriesCode String   @map("series_code")
  fyCode     String   @map("fy_code")
  lastNo     Int      @default(0) @map("last_no")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([seriesCode, fyCode])
  @@map("number_series")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only. Row-level changes written by trigger `audit_row_change`; POST/CANCEL/CLOSE/APPROVE by core/audit.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(3)
  userId    String?  @map("user_id") @db.Uuid
  requestId String?  @map("request_id")
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  action    String
  reason    String?
  docNo     String?  @map("doc_no")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")

  @@index([tableName, recordId])
  @@index([userId, at])
  @@index([at])
  @@map("audit_log")
}

// ───────────────────────────── Stock core ─────────────────────────────

model Location {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  kind      LocationKind
  vendorId  String?      @unique @map("vendor_id") @db.Uuid
  isActive  Boolean      @default(true) @map("is_active")
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  movesOut  StockMovement[] @relation("from")
  movesIn   StockMovement[] @relation("to")

  @@map("locations")
}

model Item {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  type      ItemType
  unit      Unit
  hsnCode   String?         @map("hsn_code")
  spec      String?
  gsm       Int?
  isActive  Boolean         @default(true) @map("is_active")
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  movements StockMovement[]

  @@index([type])
  @@map("items")
}

/// The single stock ledger. Written only by core/ledger. Append-only (reversals are new rows).
model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  lot           String   @default("")
  colour        String   @default("")
  size          String   @default("")
  rollId        String?  @map("roll_id") @db.Uuid
  bundleId      String?  @map("bundle_id") @db.Uuid
  cartonId      String?  @map("carton_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  qty           Decimal  @db.Decimal(12, 3)
  unit          Unit
  fromLocationId String  @map("from_location_id") @db.Uuid
  toLocationId  String   @map("to_location_id") @db.Uuid
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id") @db.Uuid
  sourceLineKey String   @map("source_line_key")
  isReversal    Boolean  @default(false) @map("is_reversal")
  reversalOfId  String?  @map("reversal_of_id") @db.Uuid
  docDate       DateTime @map("doc_date") @db.Date
  postedAt      DateTime @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedById    String   @map("posted_by_id") @db.Uuid
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocation  Location @relation("from", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation    Location @relation("to", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, sourceLineKey, isReversal])
  @@index([itemId, fromLocationId])
  @@index([itemId, toLocationId])
  @@index([orderId])
  @@index([rollId])
  @@index([bundleId])
  @@index([docDate])
  @@map("stock_movements")
}

// ───────────────────────────── Files, alerts, notifications, jobs ─────────────────────────────

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ownerType    String   @map("owner_type")
  ownerId      String   @map("owner_id") @db.Uuid
  fileKey      String   @unique @map("file_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerType, ownerId])
  @@map("attachments")
}

/// System alerts (overdue D.C., GST time limit, excess loss, payment due). One ACTIVE row per dedupe_key (partial unique index in SQL).
model Alert {
  id               String      @id @default(uuid()) @db.Uuid
  kind             String
  severity         String
  title            String
  message          String
  docType          String?     @map("doc_type")
  docId            String?     @map("doc_id") @db.Uuid
  docNo            String?     @map("doc_no")
  dedupeKey        String      @map("dedupe_key")
  status           AlertStatus @default(ACTIVE)
  data             Json?
  firstSeenAt      DateTime    @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt       DateTime?   @map("resolved_at") @db.Timestamptz(3)
  acknowledgedById String?     @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt   DateTime?   @map("acknowledged_at") @db.Timestamptz(3)
  notifications    Notification[]

  @@index([status, kind])
  @@index([dedupeKey])
  @@map("alerts")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  kind       String
  title      String
  body       String
  link       String?
  alertId    String?                @map("alert_id") @db.Uuid
  eventKey   String                 @map("event_key")
  readAt     DateTime?              @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert      Alert?                 @relation(fields: [alertId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([userId, eventKey])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String         @id @default(uuid()) @db.Uuid
  notificationId    String         @map("notification_id") @db.Uuid
  channel           String
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  lastError         String?        @map("last_error")
  providerMessageId String?        @map("provider_message_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification      Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

model ReportExport {
  id            String       @id @default(uuid()) @db.Uuid
  reportKey     String       @map("report_key")
  params        Json
  status        ExportStatus @default(QUEUED)
  requestedById String       @map("requested_by_id") @db.Uuid
  fileKey       String?      @map("file_key")
  fileName      String?      @map("file_name")
  rowCount      Int?         @map("row_count")
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)

  @@index([requestedById, createdAt])
  @@map("report_exports")
}

// ───────────────────────────── Masters (Step 2) ─────────────────────────────

enum ProcessStage {
  KG
  PCS
}

/// Job-work and supply processes (knitting, dyeing, compacting, printing, embroidery …).
model Process {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique
  name              String
  stage             ProcessStage
  defaultReturnDays Int             @default(15) @map("default_return_days")
  isActive          Boolean         @default(true) @map("is_active")
  version           Int             @default(1)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendors           VendorProcess[]

  @@map("processes")
}

/// Vendors: mills, job workers (knitters, dyers, compactors, printers, embroiderers), trims suppliers.
/// Creating a vendor auto-creates its stock location (B-Step 2).
model Vendor {
  id                     String          @id @default(uuid()) @db.Uuid
  code                   String          @unique
  name                   String
  gstin                  String?
  pan                    String?
  addressLine1           String?         @map("address_line1")
  addressLine2           String?         @map("address_line2")
  city                   String?
  state                  String?
  stateCode              String?         @map("state_code")
  pincode                String?
  contactPerson          String?         @map("contact_person")
  phone                  String?
  email                  String?
  creditDays             Int             @default(0) @map("credit_days")
  /// TDS u/s 194C — configured per vendor, confirmed with auditor (Q-008). Never applied automatically when false.
  tdsApplicable          Boolean         @default(false) @map("tds_applicable")
  tdsRatePct             Decimal?        @map("tds_rate_pct") @db.Decimal(6, 3)
  /// Whether debit notes to this vendor carry GST (Q-008). Default false.
  debitNoteGstApplicable Boolean         @default(false) @map("debit_note_gst_applicable")
  debitNoteGstRatePct    Decimal?        @map("debit_note_gst_rate_pct") @db.Decimal(6, 3)
  bankName               String?         @map("bank_name")
  bankAccount            String?         @map("bank_account")
  bankIfsc               String?         @map("bank_ifsc")
  whatsappNumber         String?         @map("whatsapp_number")
  isActive               Boolean         @default(true) @map("is_active")
  version                Int             @default(1)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  processes              VendorProcess[]

  @@index([name])
  @@map("vendors")
}

model VendorProcess {
  vendorId  String  @map("vendor_id") @db.Uuid
  processId String  @map("process_id") @db.Uuid
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  process   Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@id([vendorId, processId])
  @@map("vendor_processes")
}

model Buyer {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  country       String?
  addressLine1  String?  @map("address_line1")
  addressLine2  String?  @map("address_line2")
  city          String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  currency      String   @default("USD")
  paymentTerms  String?  @map("payment_terms")
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@map("buyers")
}

/// Idempotency ledger for business events processed by services and jobs.
model ProcessedEvent {
  key         String   @id
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)
  result      Json?

  @@map("processed_events")
}
