// Wewin ERP — database schema.
// Conventions: snake_case tables/columns, UUID ids, kg Decimal(12,3), money Decimal(14,2), rates Decimal(12,4).
// Only apps/api/src/core/ledger writes stock_movements. audit_log and stock_movements are append-only (DB triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum DocStatus {
  DRAFT
  POSTED
  CLOSED
  CANCELLED
}

enum Unit {
  KG
  PCS
  NOS
}

enum LocationKind {
  OWN
  VENDOR
  VIRTUAL
}

enum ItemType {
  YARN
  FABRIC
  PANEL
  GARMENT
  TRIM
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
}

enum ExportStatus {
  QUEUED
  RUNNING
  READY
  FAILED
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  username           String         @unique
  fullName           String         @map("full_name")
  email              String?
  phone              String?
  passwordHash       String         @map("password_hash")
  isActive           Boolean        @default(true) @map("is_active")
  failedLoginCount   Int            @default(0) @map("failed_login_count")
  lockedUntil        DateTime?      @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?      @map("last_login_at") @db.Timestamptz(3)
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles              UserRole[]
  sessions           Session[]
  notifications      Notification[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  isActive    Boolean          @default(true) @map("is_active")
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  key         String           @id
  module      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Refresh-token sessions. Token stored as SHA-256 hash; rotated on every refresh.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  username  String
  userId    String?  @map("user_id") @db.Uuid
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([username, createdAt])
  @@map("login_events")
}

// ───────────────────────────── Settings & numbering ─────────────────────────────

model CompanySettings {
  id            Int       @id @default(1)
  legalName     String    @map("legal_name")
  tradeName     String?   @map("trade_name")
  addressLine1  String    @map("address_line1")
  addressLine2  String?   @map("address_line2")
  city          String
  state         String
  stateCode     String    @map("state_code")
  pincode       String
  gstin         String
  pan           String?
  phone         String?
  email         String?
  iec           String?
  lutNumber     String?   @map("lut_number")
  lutValidFrom  DateTime? @map("lut_valid_from") @db.Date
  lutValidTo    DateTime? @map("lut_valid_to") @db.Date
  bankName      String?   @map("bank_name")
  bankAccount   String?   @map("bank_account")
  bankIfsc      String?   @map("bank_ifsc")
  logoFileKey   String?   @map("logo_file_key")
  isPlaceholder Boolean   @default(false) @map("is_placeholder")
  version       Int       @default(1)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_settings")
}

/// Typed business settings (tolerances, GST windows, thresholds). Values validated by @wewin/shared.
model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

model DocumentSeries {
  code     String  @id
  name     String
  prefix   String
  padding  Int     @default(4)
  isActive Boolean @default(true) @map("is_active")

  @@map("document_series")
}

model NumberSeries {
  id         String   @id @default(uuid()) @db.Uuid
  seriesCode String   @map("series_code")
  fyCode     String   @map("fy_code")
  lastNo     Int      @default(0) @map("last_no")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([seriesCode, fyCode])
  @@map("number_series")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only. Row-level changes written by trigger `audit_row_change`; POST/CANCEL/CLOSE/APPROVE by core/audit.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  at        DateTime @default(now()) @db.Timestamptz(3)
  userId    String?  @map("user_id") @db.Uuid
  requestId String?  @map("request_id")
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  action    String
  reason    String?
  docNo     String?  @map("doc_no")
  oldData   Json?    @map("old_data")
  newData   Json?    @map("new_data")

  @@index([tableName, recordId])
  @@index([userId, at])
  @@index([at])
  @@map("audit_log")
}

// ───────────────────────────── Stock core ─────────────────────────────

model Location {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  kind        LocationKind
  vendorId    String?         @unique @map("vendor_id") @db.Uuid
  isActive    Boolean         @default(true) @map("is_active")
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  movesOut    StockMovement[] @relation("from")
  movesIn     StockMovement[] @relation("to")
  outwardFrom OutwardDc[]     @relation("outwardFrom")
  inwardTo    InwardDc[]      @relation("inwardTo")

  @@map("locations")
}

model Item {
  id               String                 @id @default(uuid()) @db.Uuid
  code             String                 @unique
  name             String
  type             ItemType
  unit             Unit
  hsnCode          String?                @map("hsn_code")
  spec             String?
  gsm              Int?
  isActive         Boolean                @default(true) @map("is_active")
  version          Int                    @default(1)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  movements        StockMovement[]
  garmentOrders    Order[]                @relation("garmentItem")
  panelComponents  OrderComponent[]       @relation("panelItem")
  programFabrics   FabricProgram[]        @relation("programFabric")
  ppInputs         FabricProgramProcess[] @relation("ppInput")
  ppOutputs        FabricProgramProcess[] @relation("ppOutput")
  trimsBomLines    TrimsBomLine[]         @relation("trimItem")
  yarnReceiptLines YarnReceiptLine[]      @relation("yarnReceiptItem")
  outwardLines     OutwardDcLine[]        @relation("outwardLineItem")
  inwardLines      InwardDcLine[]         @relation("inwardLineItem")
  rolls            FabricRoll[]           @relation("rollItem")
  bundles          CutBundle[]            @relation("bundlePanel")
  panelDcLines     PanelDcLine[]          @relation("panelDcItem")
  recutLines       RecutSlipLine[]        @relation("recutPanel")
  trimsDocLines    TrimsDocLine[]         @relation("trimsDocItem")
  rateContracts    RateContract[]         @relation("rateItem")

  @@index([type])
  @@map("items")
}

/// The single stock ledger. Written only by core/ledger. Append-only (reversals are new rows).
model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  lot            String   @default("")
  colour         String   @default("")
  size           String   @default("")
  rollId         String?  @map("roll_id") @db.Uuid
  bundleId       String?  @map("bundle_id") @db.Uuid
  cartonId       String?  @map("carton_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  qty            Decimal  @db.Decimal(12, 3)
  unit           Unit
  fromLocationId String   @map("from_location_id") @db.Uuid
  toLocationId   String   @map("to_location_id") @db.Uuid
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id") @db.Uuid
  sourceLineKey  String   @map("source_line_key")
  isReversal     Boolean  @default(false) @map("is_reversal")
  reversalOfId   String?  @map("reversal_of_id") @db.Uuid
  docDate        DateTime @map("doc_date") @db.Date
  postedAt       DateTime @default(now()) @map("posted_at") @db.Timestamptz(3)
  postedById     String   @map("posted_by_id") @db.Uuid
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  fromLocation   Location @relation("from", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location @relation("to", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, sourceLineKey, isReversal])
  @@index([itemId, fromLocationId])
  @@index([itemId, toLocationId])
  @@index([orderId])
  @@index([rollId])
  @@index([bundleId])
  @@index([docDate])
  @@map("stock_movements")
}

// ───────────────────────────── Files, alerts, notifications, jobs ─────────────────────────────

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ownerType    String   @map("owner_type")
  ownerId      String   @map("owner_id") @db.Uuid
  fileKey      String   @unique @map("file_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerType, ownerId])
  @@map("attachments")
}

/// System alerts (overdue D.C., GST time limit, excess loss, payment due). One ACTIVE row per dedupe_key (partial unique index in SQL).
model Alert {
  id               String         @id @default(uuid()) @db.Uuid
  kind             String
  severity         String
  title            String
  message          String
  docType          String?        @map("doc_type")
  docId            String?        @map("doc_id") @db.Uuid
  docNo            String?        @map("doc_no")
  dedupeKey        String         @map("dedupe_key")
  status           AlertStatus    @default(ACTIVE)
  data             Json?
  firstSeenAt      DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt       DateTime?      @map("resolved_at") @db.Timestamptz(3)
  acknowledgedById String?        @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt   DateTime?      @map("acknowledged_at") @db.Timestamptz(3)
  notifications    Notification[]

  @@index([status, kind])
  @@index([dedupeKey])
  @@map("alerts")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  kind       String
  title      String
  body       String
  link       String?
  alertId    String?                @map("alert_id") @db.Uuid
  eventKey   String                 @map("event_key")
  readAt     DateTime?              @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert      Alert?                 @relation(fields: [alertId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([userId, eventKey])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id                String         @id @default(uuid()) @db.Uuid
  notificationId    String         @map("notification_id") @db.Uuid
  channel           String
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  lastError         String?        @map("last_error")
  providerMessageId String?        @map("provider_message_id")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  notification      Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@map("notification_deliveries")
}

model ReportExport {
  id            String       @id @default(uuid()) @db.Uuid
  reportKey     String       @map("report_key")
  params        Json
  status        ExportStatus @default(QUEUED)
  requestedById String       @map("requested_by_id") @db.Uuid
  fileKey       String?      @map("file_key")
  fileName      String?      @map("file_name")
  rowCount      Int?         @map("row_count")
  error         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)

  @@index([requestedById, createdAt])
  @@map("report_exports")
}

// ───────────────────────────── Masters (Step 2) ─────────────────────────────

enum ProcessStage {
  KG
  PCS
}

/// Job-work and supply processes (knitting, dyeing, compacting, printing, embroidery …).
model Process {
  id                String                 @id @default(uuid()) @db.Uuid
  code              String                 @unique
  name              String
  stage             ProcessStage
  defaultReturnDays Int                    @default(15) @map("default_return_days")
  isActive          Boolean                @default(true) @map("is_active")
  version           Int                    @default(1)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendors           VendorProcess[]
  programProcesses  FabricProgramProcess[]
  outwardDcs        OutwardDc[]            @relation("outwardProcess")
  panelDcs          PanelDc[]              @relation("panelProcess")
  rateContracts     RateContract[]         @relation("rateProcess")

  @@map("processes")
}

/// Vendors: mills, job workers (knitters, dyers, compactors, printers, embroiderers), trims suppliers.
/// Creating a vendor auto-creates its stock location (B-Step 2).
model Vendor {
  id                     String           @id @default(uuid()) @db.Uuid
  code                   String           @unique
  name                   String
  gstin                  String?
  pan                    String?
  addressLine1           String?          @map("address_line1")
  addressLine2           String?          @map("address_line2")
  city                   String?
  state                  String?
  stateCode              String?          @map("state_code")
  pincode                String?
  contactPerson          String?          @map("contact_person")
  phone                  String?
  email                  String?
  creditDays             Int              @default(0) @map("credit_days")
  /// TDS u/s 194C — configured per vendor, confirmed with auditor (Q-008). Never applied automatically when false.
  tdsApplicable          Boolean          @default(false) @map("tds_applicable")
  tdsRatePct             Decimal?         @map("tds_rate_pct") @db.Decimal(6, 3)
  /// Whether debit notes to this vendor carry GST (Q-008). Default false.
  debitNoteGstApplicable Boolean          @default(false) @map("debit_note_gst_applicable")
  debitNoteGstRatePct    Decimal?         @map("debit_note_gst_rate_pct") @db.Decimal(6, 3)
  bankName               String?          @map("bank_name")
  bankAccount            String?          @map("bank_account")
  bankIfsc               String?          @map("bank_ifsc")
  whatsappNumber         String?          @map("whatsapp_number")
  isActive               Boolean          @default(true) @map("is_active")
  version                Int              @default(1)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  processes              VendorProcess[]
  yarnReceipts           YarnReceipt[]
  outwardDcs             OutwardDc[]      @relation("outwardVendor")
  inwardDcs              InwardDc[]       @relation("inwardVendor")
  panelDcs               PanelDc[]        @relation("panelVendor")
  trimsDocs              TrimsDoc[]       @relation("trimsVendor")
  rateContracts          RateContract[]   @relation("rateVendor")
  bills                  VendorBill[]     @relation("billVendor")
  debitNotes             DebitNote[]      @relation("dnVendor")
  payments               PaymentVoucher[] @relation("payVendor")

  @@index([name])
  @@map("vendors")
}

model VendorProcess {
  vendorId  String  @map("vendor_id") @db.Uuid
  processId String  @map("process_id") @db.Uuid
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  process   Process @relation(fields: [processId], references: [id], onDelete: Restrict)

  @@id([vendorId, processId])
  @@map("vendor_processes")
}

model Buyer {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  country       String?
  addressLine1  String?  @map("address_line1")
  addressLine2  String?  @map("address_line2")
  city          String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  currency      String   @default("USD")
  paymentTerms  String?  @map("payment_terms")
  isActive      Boolean  @default(true) @map("is_active")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders        Order[]

  @@index([name])
  @@map("buyers")
}

// ───────────────────────────── Orders & programs (Step 3) ─────────────────────────────

enum OrderStatus {
  DRAFT
  CONFIRMED
  CLOSED
  CANCELLED
}

enum ProgramStatus {
  DRAFT
  APPROVED
  CANCELLED
}

/// Buyer order (PO) for one style; quantities per colour × size in order_lines.
model Order {
  id            String           @id @default(uuid()) @db.Uuid
  orderNo       String           @unique @map("order_no")
  buyerId       String           @map("buyer_id") @db.Uuid
  buyerPoNo     String           @map("buyer_po_no")
  poDate        DateTime         @map("po_date") @db.Date
  shipDate      DateTime?        @map("ship_date") @db.Date
  styleNo       String           @map("style_no")
  styleName     String?          @map("style_name")
  description   String?
  garmentItemId String           @map("garment_item_id") @db.Uuid
  currency      String           @default("USD")
  colours       String[]         @default([])
  sizes         String[]         @default([])
  status        OrderStatus      @default(DRAFT)
  remarks       String?
  version       Int              @default(1)
  confirmedAt   DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?          @map("confirmed_by_id") @db.Uuid
  closedAt      DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  buyer         Buyer            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  garmentItem   Item             @relation("garmentItem", fields: [garmentItemId], references: [id], onDelete: Restrict)
  lines         OrderLine[]
  components    OrderComponent[]
  costing       OrderCosting?
  programs      FabricProgram[]
  trimsBom      TrimsBomLine[]
  yarnReceipts  YarnReceipt[]
  outwardDcs    OutwardDc[]      @relation("outwardOrder")
  cutLays       CutLay[]         @relation("cutOrder")
  panelDcs      PanelDc[]        @relation("panelOrder")
  recutSlips    RecutSlip[]      @relation("recutOrder")
  sewingIssues  SewingIssue[]    @relation("sewIssueOrder")
  sewingEntries SewingEntry[]    @relation("sewEntryOrder")
  cartons       Carton[]         @relation("cartonOrder")
  packingLists  PackingList[]    @relation("packingOrder")
  trimsDocs     TrimsDoc[]       @relation("trimsOrder")
  rateContracts RateContract[]   @relation("rateOrder")
  bills         VendorBill[]     @relation("billOrder")

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  colour    String
  size      String
  qty       Int
  unitPrice Decimal? @map("unit_price") @db.Decimal(12, 4)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, colour, size])
  @@map("order_lines")
}

/// Garment components: which panel item and how many pieces make one garment (Q-014).
model OrderComponent {
  id            String @id @default(uuid()) @db.Uuid
  orderId       String @map("order_id") @db.Uuid
  code          String
  name          String
  panelItemId   String @map("panel_item_id") @db.Uuid
  pcsPerGarment Int    @default(1) @map("pcs_per_garment")
  sortOrder     Int    @default(0) @map("sort_order")
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  panelItem     Item   @relation("panelItem", fields: [panelItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, code])
  @@map("order_components")
}

/// Costing sheet. panel_cost_per_piece values rejected/missing panels (A§7.2).
model OrderCosting {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @unique @map("order_id") @db.Uuid
  panelCostPerPiece Decimal?           @map("panel_cost_per_piece") @db.Decimal(12, 4)
  fobPerPiece       Decimal?           @map("fob_per_piece") @db.Decimal(12, 4)
  exchangeRate      Decimal?           @map("exchange_rate") @db.Decimal(12, 4)
  remarks           String?
  version           Int                @default(1)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines             OrderCostingLine[]

  @@map("order_costings")
}

model OrderCostingLine {
  id          String       @id @default(uuid()) @db.Uuid
  costingId   String       @map("costing_id") @db.Uuid
  sortOrder   Int          @default(0) @map("sort_order")
  head        String
  basis       String
  consumption Decimal      @db.Decimal(12, 4)
  rate        Decimal      @db.Decimal(12, 4)
  costing     OrderCosting @relation(fields: [costingId], references: [id], onDelete: Cascade)

  @@map("order_costing_lines")
}

/// Fabric program: route from yarn to finished fabric with allowed loss % per process (A§7.1).
model FabricProgram {
  id           String                 @id @default(uuid()) @db.Uuid
  programNo    String                 @unique @map("program_no")
  orderId      String                 @map("order_id") @db.Uuid
  fabricItemId String                 @map("fabric_item_id") @db.Uuid
  colour       String?
  requiredKg   Decimal                @map("required_kg") @db.Decimal(12, 3)
  gsm          Int?
  dia          String?
  status       ProgramStatus          @default(DRAFT)
  remarks      String?
  version      Int                    @default(1)
  approvedAt   DateTime?              @map("approved_at") @db.Timestamptz(3)
  approvedById String?                @map("approved_by_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fabricItem   Item                   @relation("programFabric", fields: [fabricItemId], references: [id], onDelete: Restrict)
  processes    FabricProgramProcess[]

  @@index([orderId])
  @@map("fabric_programs")
}

model FabricProgramProcess {
  id                String        @id @default(uuid()) @db.Uuid
  programId         String        @map("program_id") @db.Uuid
  sequence          Int
  processId         String        @map("process_id") @db.Uuid
  inputItemId       String        @map("input_item_id") @db.Uuid
  outputItemId      String        @map("output_item_id") @db.Uuid
  allowedLossPct    Decimal       @map("allowed_loss_pct") @db.Decimal(7, 4)
  /// Cost per kg of the INPUT material, used to value excess loss (Q-003).
  materialCostPerKg Decimal?      @map("material_cost_per_kg") @db.Decimal(12, 4)
  plannedVendorId   String?       @map("planned_vendor_id") @db.Uuid
  program           FabricProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  process           Process       @relation(fields: [processId], references: [id], onDelete: Restrict)
  inputItem         Item          @relation("ppInput", fields: [inputItemId], references: [id], onDelete: Restrict)
  outputItem        Item          @relation("ppOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  outwardDcs        OutwardDc[]

  @@unique([programId, sequence])
  @@map("fabric_program_processes")
}

/// Trims bill of materials per order (Q-030: attached to the order, served by the programs module).
model TrimsBomLine {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  trimItemId    String  @map("trim_item_id") @db.Uuid
  colour        String?
  size          String?
  qtyPerGarment Decimal @map("qty_per_garment") @db.Decimal(12, 4)
  wastagePct    Decimal @default(0) @map("wastage_pct") @db.Decimal(7, 4)
  remarks       String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trimItem      Item    @relation("trimItem", fields: [trimItemId], references: [id], onDelete: Restrict)

  @@map("trims_bom_lines")
}

// ───────────────────────────── Yarn store (Step 4) ─────────────────────────────

/// Yarn receipt from a mill → posts SUPPLIER → YARN_STORE.
model YarnReceipt {
  id                  String            @id @default(uuid()) @db.Uuid
  docNo               String?           @unique @map("doc_no")
  docDate             DateTime          @map("doc_date") @db.Date
  vendorId            String            @map("vendor_id") @db.Uuid
  orderId             String?           @map("order_id") @db.Uuid
  supplierInvoiceNo   String?           @map("supplier_invoice_no")
  supplierInvoiceDate DateTime?         @map("supplier_invoice_date") @db.Date
  vehicleNo           String?           @map("vehicle_no")
  remarks             String?
  status              DocStatus         @default(DRAFT)
  version             Int               @default(1)
  postedAt            DateTime?         @map("posted_at") @db.Timestamptz(3)
  postedById          String?           @map("posted_by_id") @db.Uuid
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById       String?           @map("cancelled_by_id") @db.Uuid
  cancelReason        String?           @map("cancel_reason")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById         String?           @map("created_by_id") @db.Uuid
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor              Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order               Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines               YarnReceiptLine[]

  @@index([status, docDate])
  @@index([vendorId])
  @@map("yarn_receipts")
}

model YarnReceiptLine {
  id        String      @id @default(uuid()) @db.Uuid
  receiptId String      @map("receipt_id") @db.Uuid
  lineNo    Int         @map("line_no")
  itemId    String      @map("item_id") @db.Uuid
  lot       String
  bags      Int?
  qtyKg     Decimal     @map("qty_kg") @db.Decimal(12, 3)
  ratePerKg Decimal?    @map("rate_per_kg") @db.Decimal(12, 4)
  receipt   YarnReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item      Item        @relation("yarnReceiptItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("yarn_receipt_lines")
}

// ───────────────────────────── Fabric job work (Step 5) ─────────────────────────────

/// Outward delivery challan (Rule 55): material sent to a job worker under an approved program process.
model OutwardDc {
  id                 String               @id @default(uuid()) @db.Uuid
  docNo              String?              @unique @map("doc_no")
  docDate            DateTime             @map("doc_date") @db.Date
  vendorId           String               @map("vendor_id") @db.Uuid
  programProcessId   String               @map("program_process_id") @db.Uuid
  processId          String               @map("process_id") @db.Uuid
  orderId            String               @map("order_id") @db.Uuid
  /// YARN_STORE / FABRIC_STORE, or another vendor's location for a direct vendor → vendor transfer.
  fromLocationId     String               @map("from_location_id") @db.Uuid
  expectedReturnDate DateTime?            @map("expected_return_date") @db.Date
  purpose            String               @default("For job work")
  vehicleNo          String?              @map("vehicle_no")
  remarks            String?
  status             DocStatus            @default(DRAFT)
  version            Int                  @default(1)
  /// Snapshot at posting so later program edits can never change this D.C.'s loss limit.
  allowedLossPct     Decimal?             @map("allowed_loss_pct") @db.Decimal(7, 4)
  postedAt           DateTime?            @map("posted_at") @db.Timestamptz(3)
  postedById         String?              @map("posted_by_id") @db.Uuid
  cancelledAt        DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?              @map("cancelled_by_id") @db.Uuid
  cancelReason       String?              @map("cancel_reason")
  closedAt           DateTime?            @map("closed_at") @db.Timestamptz(3)
  closedById         String?              @map("closed_by_id") @db.Uuid
  closeReason        String?              @map("close_reason")
  /// Frozen on close (A§7.1).
  finalSentKg        Decimal?             @map("final_sent_kg") @db.Decimal(12, 3)
  finalReceivedKg    Decimal?             @map("final_received_kg") @db.Decimal(12, 3)
  finalLossKg        Decimal?             @map("final_loss_kg") @db.Decimal(12, 3)
  finalLossPct       Decimal?             @map("final_loss_pct") @db.Decimal(9, 4)
  finalExcessKg      Decimal?             @map("final_excess_kg") @db.Decimal(12, 3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById        String?              @map("created_by_id") @db.Uuid
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor             Vendor               @relation("outwardVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  programProcess     FabricProgramProcess @relation(fields: [programProcessId], references: [id], onDelete: Restrict)
  process            Process              @relation("outwardProcess", fields: [processId], references: [id], onDelete: Restrict)
  order              Order                @relation("outwardOrder", fields: [orderId], references: [id], onDelete: Restrict)
  fromLocation       Location             @relation("outwardFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  lines              OutwardDcLine[]
  links              DcLink[]

  @@index([status, docDate])
  @@index([vendorId, status])
  @@index([orderId])
  @@map("outward_dcs")
}

model OutwardDcLine {
  id           String          @id @default(uuid()) @db.Uuid
  dcId         String          @map("dc_id") @db.Uuid
  lineNo       Int             @map("line_no")
  itemId       String          @map("item_id") @db.Uuid
  lot          String          @default("")
  colour       String          @default("")
  rollId       String?         @map("roll_id") @db.Uuid
  qtyKg        Decimal         @map("qty_kg") @db.Decimal(12, 3)
  rolls        Int?
  /// Rule 55 value (Q-015).
  valuePerKg   Decimal?        @map("value_per_kg") @db.Decimal(12, 4)
  dc           OutwardDc       @relation(fields: [dcId], references: [id], onDelete: Cascade)
  item         Item            @relation("outwardLineItem", fields: [itemId], references: [id], onDelete: Restrict)
  roll         FabricRoll?     @relation("outwardRoll", fields: [rollId], references: [id], onDelete: Restrict)
  consumptions DcConsumption[]

  @@map("outward_dc_lines")
}

/// Inward delivery challan: processed material returned by a job worker, roll by roll.
model InwardDc {
  id            String         @id @default(uuid()) @db.Uuid
  docNo         String?        @unique @map("doc_no")
  docDate       DateTime       @map("doc_date") @db.Date
  vendorId      String         @map("vendor_id") @db.Uuid
  vendorDcNo    String?        @map("vendor_dc_no")
  vendorDcDate  DateTime?      @map("vendor_dc_date") @db.Date
  /// FABRIC_STORE, or the vendor's own location when output stays there for a direct transfer (Q-034).
  toLocationId  String         @map("to_location_id") @db.Uuid
  vehicleNo     String?        @map("vehicle_no")
  remarks       String?
  status        DocStatus      @default(DRAFT)
  version       Int            @default(1)
  postedAt      DateTime?      @map("posted_at") @db.Timestamptz(3)
  postedById    String?        @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?        @map("cancelled_by_id") @db.Uuid
  cancelReason  String?        @map("cancel_reason")
  /// Set by accounts when a vendor bill covering this D.C. is posted (never billed twice).
  billId        String?        @map("bill_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?        @map("created_by_id") @db.Uuid
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor        Vendor         @relation("inwardVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  toLocation    Location       @relation("inwardTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines         InwardDcLine[]
  links         DcLink[]

  @@index([status, docDate])
  @@index([vendorId, status])
  @@map("inward_dcs")
}

model InwardDcLine {
  id      String      @id @default(uuid()) @db.Uuid
  dcId    String      @map("dc_id") @db.Uuid
  lineNo  Int         @map("line_no")
  itemId  String      @map("item_id") @db.Uuid
  rollNo  String      @map("roll_no")
  kg      Decimal     @db.Decimal(12, 3)
  lot     String      @default("")
  colour  String      @default("")
  gsm     Int?
  dia     String?
  remarks String?
  dc      InwardDc    @relation(fields: [dcId], references: [id], onDelete: Cascade)
  item    Item        @relation("inwardLineItem", fields: [itemId], references: [id], onDelete: Restrict)
  roll    FabricRoll?

  @@map("inward_dc_lines")
}

/// dc_links: how much of an inward D.C.'s received kg counts against each outward D.C. (A§7.1, Q-004).
model DcLink {
  id           String          @id @default(uuid()) @db.Uuid
  inwardDcId   String          @map("inward_dc_id") @db.Uuid
  outwardDcId  String          @map("outward_dc_id") @db.Uuid
  receivedKg   Decimal         @map("received_kg") @db.Decimal(12, 3)
  inward       InwardDc        @relation(fields: [inwardDcId], references: [id], onDelete: Cascade)
  outward      OutwardDc       @relation(fields: [outwardDcId], references: [id], onDelete: Restrict)
  consumptions DcConsumption[]

  @@unique([inwardDcId, outwardDcId])
  @@map("dc_links")
}

/// Input consumed at the vendor per outward line when an inward D.C. is posted.
model DcConsumption {
  id            String        @id @default(uuid()) @db.Uuid
  linkId        String        @map("link_id") @db.Uuid
  outwardLineId String        @map("outward_line_id") @db.Uuid
  kg            Decimal       @db.Decimal(12, 3)
  link          DcLink        @relation(fields: [linkId], references: [id], onDelete: Cascade)
  outwardLine   OutwardDcLine @relation(fields: [outwardLineId], references: [id], onDelete: Restrict)

  @@map("dc_consumptions")
}

/// Fabric roll created by a posted inward D.C. Its location is derived from the ledger (roll_id).
model FabricRoll {
  id           String          @id @default(uuid()) @db.Uuid
  rollNo       String          @unique @map("roll_no")
  itemId       String          @map("item_id") @db.Uuid
  lot          String          @default("")
  colour       String          @default("")
  gsm          Int?
  dia          String?
  kg           Decimal         @db.Decimal(12, 3)
  orderId      String?         @map("order_id") @db.Uuid
  inwardLineId String          @unique @map("inward_line_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  item         Item            @relation("rollItem", fields: [itemId], references: [id], onDelete: Restrict)
  inwardLine   InwardDcLine    @relation(fields: [inwardLineId], references: [id], onDelete: Restrict)
  outwardLines OutwardDcLine[] @relation("outwardRoll")
  layRolls     CutLayRoll[]    @relation("layRoll")

  @@index([itemId, lot])
  @@map("fabric_rolls")
}

// ───────────────────────────── Production (Phase 2: Steps 6–8) ─────────────────────────────

enum PanelDcType {
  OUT
  IN
}

/// Cutting lay: rolls consumed (FABRIC_STORE → CONSUMED), bundles produced (PRODUCTION → CUT_STORE).
model CutLay {
  id            String       @id @default(uuid()) @db.Uuid
  docNo         String?      @unique @map("doc_no")
  docDate       DateTime     @map("doc_date") @db.Date
  orderId       String       @map("order_id") @db.Uuid
  colour        String
  plies         Int?
  markerLength  Decimal?     @map("marker_length") @db.Decimal(8, 3)
  pcsPerBundle  Int?         @map("pcs_per_bundle")
  remarks       String?
  status        DocStatus    @default(DRAFT)
  version       Int          @default(1)
  postedAt      DateTime?    @map("posted_at") @db.Timestamptz(3)
  postedById    String?      @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?      @map("cancelled_by_id") @db.Uuid
  cancelReason  String?      @map("cancel_reason")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  order         Order        @relation("cutOrder", fields: [orderId], references: [id], onDelete: Restrict)
  rolls         CutLayRoll[]
  bundles       CutBundle[]

  @@index([orderId])
  @@index([status, docDate])
  @@map("cut_lays")
}

model CutLayRoll {
  id     String     @id @default(uuid()) @db.Uuid
  layId  String     @map("lay_id") @db.Uuid
  lineNo Int        @map("line_no")
  rollId String     @map("roll_id") @db.Uuid
  kgUsed Decimal    @map("kg_used") @db.Decimal(12, 3)
  lay    CutLay     @relation(fields: [layId], references: [id], onDelete: Cascade)
  roll   FabricRoll @relation("layRoll", fields: [rollId], references: [id], onDelete: Restrict)

  @@unique([layId, rollId])
  @@map("cut_lay_rolls")
}

/// Bundle of cut panels; number assigned at posting. Location derived from the ledger (bundle_id).
model CutBundle {
  id            String            @id @default(uuid()) @db.Uuid
  layId         String            @map("lay_id") @db.Uuid
  lineNo        Int               @map("line_no")
  bundleNo      String?           @unique @map("bundle_no")
  orderId       String            @map("order_id") @db.Uuid
  componentCode String            @map("component_code")
  panelItemId   String            @map("panel_item_id") @db.Uuid
  colour        String
  size          String
  pcs           Int
  lay           CutLay            @relation(fields: [layId], references: [id], onDelete: Cascade)
  panelItem     Item              @relation("bundlePanel", fields: [panelItemId], references: [id], onDelete: Restrict)
  panelDcLines  PanelDcLine[]
  sewingLines   SewingIssueLine[]

  @@index([orderId, colour, size])
  @@map("cut_bundles")
}

/// Panel delivery challan for printing / embroidery: type OUT (bundles out) or IN (good / rejected back).
model PanelDc {
  id                 String        @id @default(uuid()) @db.Uuid
  type               PanelDcType
  docNo              String?       @unique @map("doc_no")
  docDate            DateTime      @map("doc_date") @db.Date
  vendorId           String        @map("vendor_id") @db.Uuid
  processId          String        @map("process_id") @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  expectedReturnDate DateTime?     @map("expected_return_date") @db.Date
  vendorDcNo         String?       @map("vendor_dc_no")
  vehicleNo          String?       @map("vehicle_no")
  remarks            String?
  status             DocStatus     @default(DRAFT)
  version            Int           @default(1)
  postedAt           DateTime?     @map("posted_at") @db.Timestamptz(3)
  postedById         String?       @map("posted_by_id") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  cancelReason       String?       @map("cancel_reason")
  closedAt           DateTime?     @map("closed_at") @db.Timestamptz(3)
  closedById         String?       @map("closed_by_id") @db.Uuid
  closeReason        String?       @map("close_reason")
  /// IN documents: set when billed by accounts.
  billId             String?       @map("bill_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById        String?       @map("created_by_id") @db.Uuid
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor             Vendor        @relation("panelVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  process            Process       @relation("panelProcess", fields: [processId], references: [id], onDelete: Restrict)
  order              Order         @relation("panelOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines              PanelDcLine[]

  @@index([type, status, docDate])
  @@index([vendorId, type, status])
  @@map("panel_dcs")
}

/// OUT lines: bundle + pcs sent. IN lines: reference to the OUT line + good / rejected pcs.
model PanelDcLine {
  id          String        @id @default(uuid()) @db.Uuid
  dcId        String        @map("dc_id") @db.Uuid
  lineNo      Int           @map("line_no")
  bundleId    String        @map("bundle_id") @db.Uuid
  panelItemId String        @map("panel_item_id") @db.Uuid
  colour      String
  size        String
  pcs         Int           @default(0)
  outLineId   String?       @map("out_line_id") @db.Uuid
  goodPcs     Int           @default(0) @map("good_pcs")
  rejectedPcs Int           @default(0) @map("rejected_pcs")
  dc          PanelDc       @relation(fields: [dcId], references: [id], onDelete: Cascade)
  bundle      CutBundle     @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  panelItem   Item          @relation("panelDcItem", fields: [panelItemId], references: [id], onDelete: Restrict)
  outLine     PanelDcLine?  @relation("panelReturn", fields: [outLineId], references: [id], onDelete: Restrict)
  returns     PanelDcLine[] @relation("panelReturn")

  @@index([outLineId])
  @@map("panel_dc_lines")
}

/// Recut slip (Q-013): non-stock request to recut rejected / missing panels.
model RecutSlip {
  id           String          @id @default(uuid()) @db.Uuid
  docNo        String?         @unique @map("doc_no")
  docDate      DateTime        @map("doc_date") @db.Date
  orderId      String          @map("order_id") @db.Uuid
  panelDcId    String?         @map("panel_dc_id") @db.Uuid
  reason       String
  status       DocStatus       @default(DRAFT)
  version      Int             @default(1)
  postedAt     DateTime?       @map("posted_at") @db.Timestamptz(3)
  postedById   String?         @map("posted_by_id") @db.Uuid
  cancelledAt  DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?         @map("cancel_reason")
  closedAt     DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  order        Order           @relation("recutOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines        RecutSlipLine[]

  @@map("recut_slips")
}

model RecutSlipLine {
  id            String    @id @default(uuid()) @db.Uuid
  slipId        String    @map("slip_id") @db.Uuid
  lineNo        Int       @map("line_no")
  componentCode String    @map("component_code")
  panelItemId   String    @map("panel_item_id") @db.Uuid
  colour        String
  size          String
  pcs           Int
  slip          RecutSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)
  panelItem     Item      @relation("recutPanel", fields: [panelItemId], references: [id], onDelete: Restrict)

  @@map("recut_slip_lines")
}

/// Sewing issue: bundles CUT_STORE → SEWING_WIP.
model SewingIssue {
  id            String            @id @default(uuid()) @db.Uuid
  docNo         String?           @unique @map("doc_no")
  docDate       DateTime          @map("doc_date") @db.Date
  orderId       String            @map("order_id") @db.Uuid
  sewingLine    String            @map("sewing_line")
  remarks       String?
  status        DocStatus         @default(DRAFT)
  version       Int               @default(1)
  postedAt      DateTime?         @map("posted_at") @db.Timestamptz(3)
  postedById    String?           @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?           @map("cancelled_by_id") @db.Uuid
  cancelReason  String?           @map("cancel_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order         Order             @relation("sewIssueOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines         SewingIssueLine[]

  @@map("sewing_issues")
}

model SewingIssueLine {
  id       String      @id @default(uuid()) @db.Uuid
  issueId  String      @map("issue_id") @db.Uuid
  lineNo   Int         @map("line_no")
  bundleId String      @map("bundle_id") @db.Uuid
  pcs      Int
  issue    SewingIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  bundle   CutBundle   @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  @@map("sewing_issue_lines")
}

/// Daily sewing output: panels SEWING_WIP → CONSUMED, garments PRODUCTION → FINISHING.
model SewingEntry {
  id            String            @id @default(uuid()) @db.Uuid
  docNo         String?           @unique @map("doc_no")
  docDate       DateTime          @map("doc_date") @db.Date
  orderId       String            @map("order_id") @db.Uuid
  sewingLine    String            @map("sewing_line")
  shift         String?
  remarks       String?
  status        DocStatus         @default(DRAFT)
  version       Int               @default(1)
  postedAt      DateTime?         @map("posted_at") @db.Timestamptz(3)
  postedById    String?           @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?           @map("cancelled_by_id") @db.Uuid
  cancelReason  String?           @map("cancel_reason")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order         Order             @relation("sewEntryOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines         SewingEntryLine[]

  @@index([orderId, docDate])
  @@map("sewing_entries")
}

model SewingEntryLine {
  id      String      @id @default(uuid()) @db.Uuid
  entryId String      @map("entry_id") @db.Uuid
  lineNo  Int         @map("line_no")
  colour  String
  size    String
  pcs     Int
  entry   SewingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("sewing_entry_lines")
}

/// Packed carton: garments FINISHING → FG_STORE.
model Carton {
  id            String       @id @default(uuid()) @db.Uuid
  docNo         String?      @unique @map("doc_no")
  docDate       DateTime     @map("doc_date") @db.Date
  orderId       String       @map("order_id") @db.Uuid
  cartonSeq     Int?         @map("carton_seq")
  grossKg       Decimal?     @map("gross_kg") @db.Decimal(8, 3)
  netKg         Decimal?     @map("net_kg") @db.Decimal(8, 3)
  lengthCm      Decimal?     @map("length_cm") @db.Decimal(6, 1)
  widthCm       Decimal?     @map("width_cm") @db.Decimal(6, 1)
  heightCm      Decimal?     @map("height_cm") @db.Decimal(6, 1)
  remarks       String?
  status        DocStatus    @default(DRAFT)
  version       Int          @default(1)
  packingListId String?      @map("packing_list_id") @db.Uuid
  postedAt      DateTime?    @map("posted_at") @db.Timestamptz(3)
  postedById    String?      @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?      @map("cancelled_by_id") @db.Uuid
  cancelReason  String?      @map("cancel_reason")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  order         Order        @relation("cartonOrder", fields: [orderId], references: [id], onDelete: Restrict)
  packingList   PackingList? @relation(fields: [packingListId], references: [id], onDelete: Restrict)
  lines         CartonLine[]

  @@unique([orderId, cartonSeq])
  @@index([orderId, status])
  @@map("cartons")
}

model CartonLine {
  id       String @id @default(uuid()) @db.Uuid
  cartonId String @map("carton_id") @db.Uuid
  colour   String
  size     String
  pcs      Int
  carton   Carton @relation(fields: [cartonId], references: [id], onDelete: Cascade)

  @@unique([cartonId, colour, size])
  @@map("carton_lines")
}

/// Packing list: posted cartons of one order grouped for shipment (non-stock).
model PackingList {
  id              String    @id @default(uuid()) @db.Uuid
  docNo           String?   @unique @map("doc_no")
  docDate         DateTime  @map("doc_date") @db.Date
  orderId         String    @map("order_id") @db.Uuid
  remarks         String?
  status          DocStatus @default(DRAFT)
  version         Int       @default(1)
  postedAt        DateTime? @map("posted_at") @db.Timestamptz(3)
  postedById      String?   @map("posted_by_id") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?   @map("cancel_reason")
  /// Set when an export invoice is raised from this packing list.
  exportInvoiceId String?   @map("export_invoice_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  order           Order     @relation("packingOrder", fields: [orderId], references: [id], onDelete: Restrict)
  cartons         Carton[]

  @@map("packing_lists")
}

/// Trims receipt (SUPPLIER → TRIMS_STORE) or issue against an order (TRIMS_STORE → CONSUMED).
enum TrimsDocType {
  RECEIPT
  ISSUE
}

model TrimsDoc {
  id                String         @id @default(uuid()) @db.Uuid
  type              TrimsDocType
  docNo             String?        @unique @map("doc_no")
  docDate           DateTime       @map("doc_date") @db.Date
  vendorId          String?        @map("vendor_id") @db.Uuid
  orderId           String?        @map("order_id") @db.Uuid
  supplierInvoiceNo String?        @map("supplier_invoice_no")
  remarks           String?
  status            DocStatus      @default(DRAFT)
  version           Int            @default(1)
  postedAt          DateTime?      @map("posted_at") @db.Timestamptz(3)
  postedById        String?        @map("posted_by_id") @db.Uuid
  cancelledAt       DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelledById     String?        @map("cancelled_by_id") @db.Uuid
  cancelReason      String?        @map("cancel_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?        @map("created_by_id") @db.Uuid
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor            Vendor?        @relation("trimsVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  order             Order?         @relation("trimsOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines             TrimsDocLine[]

  @@index([type, status, docDate])
  @@map("trims_docs")
}

model TrimsDocLine {
  id     String   @id @default(uuid()) @db.Uuid
  docId  String   @map("doc_id") @db.Uuid
  lineNo Int      @map("line_no")
  itemId String   @map("item_id") @db.Uuid
  lot    String   @default("")
  qty    Decimal  @db.Decimal(12, 3)
  rate   Decimal? @db.Decimal(12, 4)
  doc    TrimsDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  item   Item     @relation("trimsDocItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@map("trims_doc_lines")
}

// ───────────────────────────── Accounts (Phase 3: Steps 9–10) ─────────────────────────────

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
}

/// Vendor job-work rate with effective dates (A§7.3). Most specific match wins: order + item > item > process.
model RateContract {
  id            String    @id @default(uuid()) @db.Uuid
  vendorId      String    @map("vendor_id") @db.Uuid
  processId     String    @map("process_id") @db.Uuid
  itemId        String?   @map("item_id") @db.Uuid
  orderId       String?   @map("order_id") @db.Uuid
  unit          Unit
  rate          Decimal   @db.Decimal(12, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  remarks       String?
  isActive      Boolean   @default(true) @map("is_active")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor        Vendor    @relation("rateVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  process       Process   @relation("rateProcess", fields: [processId], references: [id], onDelete: Restrict)
  item          Item?     @relation("rateItem", fields: [itemId], references: [id], onDelete: Restrict)
  order         Order?    @relation("rateOrder", fields: [orderId], references: [id], onDelete: Restrict)

  @@index([vendorId, processId, effectiveFrom])
  @@map("rate_contracts")
}

/// Vendor bill matched against posted inward D.C.s / panel inwards (3-way match, A§7.3).
model VendorBill {
  id                String              @id @default(uuid()) @db.Uuid
  docNo             String?             @unique @map("doc_no")
  docDate           DateTime            @map("doc_date") @db.Date
  vendorId          String              @map("vendor_id") @db.Uuid
  orderId           String?             @map("order_id") @db.Uuid
  vendorInvoiceNo   String              @map("vendor_invoice_no")
  vendorInvoiceDate DateTime            @map("vendor_invoice_date") @db.Date
  dueDate           DateTime            @map("due_date") @db.Date
  taxableAmount     Decimal             @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount        Decimal             @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount        Decimal             @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount        Decimal             @default(0) @map("igst_amount") @db.Decimal(14, 2)
  expectedTaxable   Decimal             @default(0) @map("expected_taxable") @db.Decimal(14, 2)
  variance          Decimal             @default(0) @db.Decimal(14, 2)
  withinTolerance   Boolean             @default(false) @map("within_tolerance")
  approvalStatus    ApprovalStatus      @default(NOT_REQUIRED) @map("approval_status")
  approvedById      String?             @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvalNote      String?             @map("approval_note")
  remarks           String?
  status            DocStatus           @default(DRAFT)
  version           Int                 @default(1)
  postedAt          DateTime?           @map("posted_at") @db.Timestamptz(3)
  postedById        String?             @map("posted_by_id") @db.Uuid
  cancelledAt       DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById     String?             @map("cancelled_by_id") @db.Uuid
  cancelReason      String?             @map("cancel_reason")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById       String?             @map("created_by_id") @db.Uuid
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor            Vendor              @relation("billVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  order             Order?              @relation("billOrder", fields: [orderId], references: [id], onDelete: Restrict)
  lines             VendorBillLine[]
  debitNotes        DebitNote[]
  allocations       PaymentAllocation[]

  @@index([vendorId, status])
  @@map("vendor_bills")
}

model VendorBillLine {
  id             String     @id @default(uuid()) @db.Uuid
  billId         String     @map("bill_id") @db.Uuid
  lineNo         Int        @map("line_no")
  /// INWARD_DC (billable = received kg) or PANEL_IN (billable = good pcs).
  sourceType     String     @map("source_type")
  sourceId       String     @map("source_id") @db.Uuid
  sourceDocNo    String     @map("source_doc_no")
  sourceDate     DateTime   @map("source_date") @db.Date
  processId      String     @map("process_id") @db.Uuid
  itemId         String?    @map("item_id") @db.Uuid
  billableQty    Decimal    @map("billable_qty") @db.Decimal(12, 3)
  unit           Unit
  rate           Decimal?   @db.Decimal(12, 4)
  rateContractId String?    @map("rate_contract_id") @db.Uuid
  expectedAmount Decimal?   @map("expected_amount") @db.Decimal(14, 2)
  invoicedAmount Decimal?   @map("invoiced_amount") @db.Decimal(14, 2)
  bill           VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([sourceType, sourceId])
  @@map("vendor_bill_lines")
}

/// Debit note to a vendor: automatic (excess loss, panel rejects / shortages) or manual.
model DebitNote {
  id            String          @id @default(uuid()) @db.Uuid
  docNo         String?         @unique @map("doc_no")
  docDate       DateTime        @map("doc_date") @db.Date
  vendorId      String          @map("vendor_id") @db.Uuid
  billId        String?         @map("bill_id") @db.Uuid
  isAuto        Boolean         @default(false) @map("is_auto")
  taxableAmount Decimal         @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  gstRatePct    Decimal?        @map("gst_rate_pct") @db.Decimal(6, 3)
  gstAmount     Decimal         @default(0) @map("gst_amount") @db.Decimal(14, 2)
  totalAmount   Decimal         @default(0) @map("total_amount") @db.Decimal(14, 2)
  remarks       String?
  status        DocStatus       @default(DRAFT)
  version       Int             @default(1)
  postedAt      DateTime?       @map("posted_at") @db.Timestamptz(3)
  postedById    String?         @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?         @map("cancelled_by_id") @db.Uuid
  cancelReason  String?         @map("cancel_reason")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor        Vendor          @relation("dnVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  bill          VendorBill?     @relation(fields: [billId], references: [id], onDelete: Restrict)
  lines         DebitNoteLine[]

  @@index([vendorId, status])
  @@map("debit_notes")
}

model DebitNoteLine {
  id          String    @id @default(uuid()) @db.Uuid
  noteId      String    @map("note_id") @db.Uuid
  lineNo      Int       @map("line_no")
  /// EXCESS_LOSS | PANEL_REJECT | PANEL_MISSING | MANUAL
  reason      String
  /// The business event debited (OUTWARD_DC id, PANEL_DC line id …). One active debit per (originType, originId, reason).
  originType  String?   @map("origin_type")
  originId    String?   @map("origin_id") @db.Uuid
  description String
  qty         Decimal   @db.Decimal(12, 3)
  unit        String
  rate        Decimal   @db.Decimal(12, 4)
  amount      Decimal   @db.Decimal(14, 2)
  active      Boolean   @default(true)
  note        DebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("debit_note_lines")
}

enum PaymentMode {
  NEFT
  RTGS
  CHEQUE
  UPI
  CASH
  ADJUSTMENT
}

/// Payment voucher allocated to bills (oldest first by default, A§7.4). Unallocated = vendor advance.
model PaymentVoucher {
  id            String              @id @default(uuid()) @db.Uuid
  docNo         String?             @unique @map("doc_no")
  docDate       DateTime            @map("doc_date") @db.Date
  vendorId      String              @map("vendor_id") @db.Uuid
  mode          PaymentMode
  reference     String?
  bankAccount   String?             @map("bank_account")
  amount        Decimal             @db.Decimal(14, 2)
  tdsAmount     Decimal             @default(0) @map("tds_amount") @db.Decimal(14, 2)
  /// Allocations may also draw on the vendor's existing advance.
  useAdvance    Boolean             @default(false) @map("use_advance")
  remarks       String?
  status        DocStatus           @default(DRAFT)
  version       Int                 @default(1)
  postedAt      DateTime?           @map("posted_at") @db.Timestamptz(3)
  postedById    String?             @map("posted_by_id") @db.Uuid
  cancelledAt   DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelledById String?             @map("cancelled_by_id") @db.Uuid
  cancelReason  String?             @map("cancel_reason")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?             @map("created_by_id") @db.Uuid
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor        Vendor              @relation("payVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]

  @@index([vendorId, status])
  @@map("payment_vouchers")
}

model PaymentAllocation {
  id        String         @id @default(uuid()) @db.Uuid
  paymentId String         @map("payment_id") @db.Uuid
  billId    String         @map("bill_id") @db.Uuid
  amount    Decimal        @db.Decimal(14, 2)
  payment   PaymentVoucher @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill      VendorBill     @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@map("payment_allocations")
}

/// Nightly ageing snapshot so month-end figures can be reproduced (A§7.5).
model AgeingSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  snapshotDate DateTime @map("snapshot_date") @db.Date
  vendorId     String   @map("vendor_id") @db.Uuid
  billId       String   @map("bill_id") @db.Uuid
  billDocNo    String   @map("bill_doc_no")
  ageFrom      DateTime @map("age_from") @db.Date
  ageDays      Int      @map("age_days")
  bucket       String
  outstanding  Decimal  @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([snapshotDate, billId])
  @@index([snapshotDate, vendorId])
  @@map("ageing_snapshots")
}

/// Idempotency ledger for business events processed by services and jobs.
model ProcessedEvent {
  key         String   @id
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)
  result      Json?

  @@map("processed_events")
}
