{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": { "cache": false, "passThroughEnv": ["JWT_SECRET", "CORS_ORIGIN", "TZ", "FY_START_MONTH", "SEED_OWNER_PASSWORD"] }
  }
}
